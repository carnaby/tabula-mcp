{
  "name": "tabula",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "nx run-many -t dev -p @tabula/server @tabula/web --output-style=stream",
    "dev:server": "nx run @tabula/server:dev --output-style=stream",
    "dev:web": "nx run @tabula/web:dev --output-style=stream",
    "db:dev": "docker start tabula-dev-db || docker run -d --name tabula-dev-db -e POSTGRES_DB=tabula -e POSTGRES_USER=tabula -e POSTGRES_PASSWORD=change-me -p 5432:5432 -v tabula-dev-pg17:/var/lib/postgresql/data postgres:17-alpine",
    "build": "nx run-many -t build --output-style=static",
    "typecheck": "nx run-many -t typecheck --output-style=static",
    "test": "nx run-many -t test --parallel=1 --output-style=static",
    "affected": "nx affected -t typecheck test build --parallel=1 --output-style=static",
    "graph": "nx graph",
    "db:generate": "pnpm --filter @tabula/server db:generate"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "nx": "24.0.5",
    "typescript": "^7.0.2"
  }
}
