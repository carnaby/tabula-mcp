{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabula tray",
  "version": "0.1.0",
  "identifier": "io.github.carnaby.tabula.tray",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tabula tray",
        "width": 460,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Starts, stops and watches the Tabula transcription worker",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  }
}
