{
  "name": "@tabula/shared",
  "private": true,
  "type": "module",
  "description": "Pure helpers the server and the web UI share: references, grouping files by folder, report titles, the Copy for Claude text.",
  "license": "MIT",
  "files": ["dist"],
  "exports": {
    "./refs": { "types": "./dist/refs.d.ts", "default": "./dist/refs.js" },
    "./file-groups": { "types": "./dist/file-groups.d.ts", "default": "./dist/file-groups.js" },
    "./report-title": { "types": "./dist/report-title.d.ts", "default": "./dist/report-title.js" },
    "./copy-prompt": { "types": "./dist/copy-prompt.d.ts", "default": "./dist/copy-prompt.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "nx": { "targets": { "test": { "cache": true } } }
}
