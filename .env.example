# Postgres (docker-compose)
POSTGRES_PASSWORD=change-me
# Bearer token for MCP and UI, >= 32 chars: openssl rand -hex 32
TABULA_TOKEN=
# Optional: enables POST /mcp/<secret> for claude.ai connector, >= 32 chars
TABULA_CONNECTOR_SECRET=
# Optional: token of the transcription worker (tabula worker), >= 32 chars, different from TABULA_TOKEN
TABULA_WORKER_TOKEN=
# Local dev only
DATABASE_URL=postgres://tabula:change-me@localhost:5432/tabula
PORT=3000
# pnpm dev runs the server in apps/server: relative paths start there
WEB_DIST=../web/dist
TABULA_MEDIA_DIR=../../data/media
