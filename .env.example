# Postgres (docker-compose)
POSTGRES_PASSWORD=change-me
# Required: the public address, e.g. https://tabula.example.com (no path): the passkey domain and the OAuth issuer
# (http://localhost:<port> for local development)
TABULA_PUBLIC_URL=http://localhost:3000
# Optional: transcription of recordings by Fornax (set both URL and token, or neither)
TABULA_FORNAX_URL=
TABULA_FORNAX_TOKEN=
# Optional: high (default), normal or low
TABULA_FORNAX_PRIORITY=
# Local dev only
DATABASE_URL=postgres://tabula:change-me@localhost:5432/tabula
PORT=3000
# pnpm dev runs the server in apps/server: relative paths start there
WEB_DIST=../web/dist
TABULA_MEDIA_DIR=../../data/media
